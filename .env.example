# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
FRONTEND_BASE_URL=http://localhost:4200

# --- Database ---
# Used as-is for local docker-compose; when using a remote Supabase Postgres
# instead of the local `postgres` service, point this at its connection string.
DATABASE_URL=postgresql+psycopg://packproof:packproof@localhost:5432/packproof

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Settings > API > JWT Settings > JWT Secret in the Supabase dashboard.
# The backend uses this to verify access tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=replace-me
SUPABASE_STORAGE_BUCKET=packproof-documents

# --- Reminders (days after sending with no response) ---
REMINDER_SCHEDULE_DAYS=[3,7,14]

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=["pdf","xlsx","csv","docx","png","jpg","jpeg"]

# --- Email (Resend) ---
# Leave empty in local dev: emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=PackProof <notifications@packproof.dev>

# --- Document extraction ---
# "stub" = no real AI/OCR call, always returns no suggestions.
DOCUMENT_EXTRACTION_PROVIDER=stub
