# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true
# Local dev default. In production this is the deployed app's origin, e.g.
# https://app.sourcelya.com (see README "Domains" for the sourcelya.com /
# app.sourcelya.com / api.sourcelya.com split).
FRONTEND_BASE_URL=http://localhost:4200

# --- Database ---
# Used as-is for local docker-compose; when using a remote Supabase Postgres
# instead of the local `postgres` service, point this at its connection string.
DATABASE_URL=postgresql+psycopg://sourcelya:sourcelya@localhost:5432/sourcelya

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=sourcelya-documents

# --- Supabase JWT verification ---
# "jwks" (default, production): verifies Supabase's asymmetric signing keys
# against https://<project>.supabase.co/auth/v1/.well-known/jwks.json.
# Requires a Supabase project reachable from this backend.
# "hs256": shared-secret fallback for local/offline dev or CI that can't
# reach a real Supabase project. Never use this in production.
SUPABASE_JWT_STRATEGY=jwks
# Leave empty to derive from SUPABASE_URL; override only for non-standard setups.
SUPABASE_JWKS_URL=
SUPABASE_ISSUER=
SUPABASE_JWT_ALLOWED_ALGORITHMS=["ES256","RS256"]
# Only read when SUPABASE_JWT_STRATEGY=hs256.
SUPABASE_JWT_SECRET=dev-secret-change-me

# --- Internal jobs ---
# Shared secret for POST /internal/jobs/process-reminders, called by
# Supabase Cron / pg_cron rather than a logged-in user. Generate with:
#   openssl rand -hex 32
INTERNAL_JOBS_SECRET=replace-me

# --- Reminders (days after sending with no response) ---
REMINDER_SCHEDULE_DAYS=[3,7,14]

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=["pdf","xlsx","csv","docx","png","jpg","jpeg"]

# --- Email (Resend) ---
# Leave empty in local dev: emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Sourcelya <notifications@sourcelya.com>

# --- Document extraction ---
# "stub" = no real AI/OCR call, always returns no suggestions.
# "anthropic" = real extraction via the Claude API (requires ANTHROPIC_API_KEY).
DOCUMENT_EXTRACTION_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-opus-5

# --- Malware scanning ---
# "stub" = no real scan, never flags anything (local dev/CI default).
# "clamav" = real scan via a reachable clamd daemon (CLAMAV_HOST/PORT).
MALWARE_SCAN_PROVIDER=stub
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
